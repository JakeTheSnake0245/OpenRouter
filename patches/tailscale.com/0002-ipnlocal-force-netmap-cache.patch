+// OpenRoute overrides for the network map disk cache.
+var (
+	// ForceCacheNetworkMaps, if set, caches network maps on disk even when the
+	// control plane doesn't grant [nodecap.CacheNetworkMaps] (Headscale
+	// doesn't), so the node can start from its last-known tailnet while
+	// offline. [nodecap.DisableCacheNetworkMaps] still turns caching off.
+	ForceCacheNetworkMaps bool
+
+	// NetworkMapCacheOff, if set, turns the cache off locally: network maps
+	// are neither written nor loaded, and a cached map found at startup is
+	// discarded.
+	NetworkMapCacheOff atomic.Bool
+
+	// CachedNetworkMapMaxAge, if positive, limits how long after the control
+	// plane last sent a network map (or peer update) a cached copy may still
+	// be loaded. Older caches are discarded, so changes made on the control
+	// plane while the node was offline, such as removing a lost device, take
+	// effect within this long.
+	CachedNetworkMapMaxAge time.Duration
+
+	// NetmapCacheStoreHook, if non-nil, wraps the store that holds cached
+	// network maps, for example to encrypt them.
+	NetmapCacheStoreHook func(netmapcache.Store) netmapcache.Store
+)
+
+// netmapCacheConfirmedFile is the profile data file whose modification time
+// records when the control plane last sent a network map.
+const netmapCacheConfirmedFile = "netmap-cache-confirmed"
+
+// netmapConfirmedPath returns the confirmation file for the cache in cacheDir.
+func netmapConfirmedPath(cacheDir string) string {
+	return filepath.Join(filepath.Dir(cacheDir), netmapCacheConfirmedFile)
+}
+
+func netmapCacheStore(dir string) netmapcache.Store {
+	var s netmapcache.Store = netmapcache.FileStore(dir)
+	if h := NetmapCacheStoreHook; h != nil {
+		s = h(s)
+	}
+	return s
+}
+
+// cacheNetworkMapsEnabled reports whether network maps for cn should be
+// cached on disk.
+func cacheNetworkMapsEnabled(cn *nodeBackend) bool {
+	if NetworkMapCacheOff.Load() || cn.SelfHasCap(nodecap.DisableCacheNetworkMaps) {
+		return false
+	}
+	return ForceCacheNetworkMaps || cn.SelfHasCap(nodecap.CacheNetworkMaps)
+}
+
+// noteNetmapConfirmedLocked records that the control plane just sent a
+// network map. It writes at most once a minute.
+func (b *LocalBackend) noteNetmapConfirmedLocked() {
+	now := time.Now()
+	if now.Sub(b.diskCache.confirmedAt) < time.Minute {
+		return
+	}
+	path := netmapConfirmedPath(b.diskCache.dir)
+	if err := os.WriteFile(path, nil, 0600); err != nil {
+		b.logf("netmap cache: recording confirmation: %v", err)
+		return
+	}
+	os.Chtimes(path, now, now)
+	b.diskCache.confirmedAt = now
+}
+
+// cachedNetmapUsableLocked reports whether a cached network map for the
+// current profile may be loaded, discarding it if not.
+func (b *LocalBackend) cachedNetmapUsableLocked(dir string) bool {
+	discard := func(why string) bool {
+		b.logf("netmap cache: %s; discarding", why)
+		if err := b.clearStoreLocked(b.currentNode().Context(), netmapcache.FileStore(dir)); err != nil {
+			b.logf("clearing netmap cache: %v", err)
+		}
+		return false
+	}
+	if NetworkMapCacheOff.Load() {
+		return discard("turned off on this device")
+	}
+	if CachedNetworkMapMaxAge <= 0 {
+		return true
+	}
+	fi, err := os.Stat(netmapConfirmedPath(dir))
+	if err != nil {
+		return discard("no record of when the control plane last confirmed it")
+	}
+	if age := time.Since(fi.ModTime()); age > CachedNetworkMapMaxAge || age < -time.Hour {
+		return discard(fmt.Sprintf("last confirmed %v ago, limit %v", age.Round(time.Minute), CachedNetworkMapMaxAge))
+	}
+	return true
+}
