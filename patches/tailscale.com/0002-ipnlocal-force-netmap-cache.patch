+// TestNetworkMapCacheOff checks the local off switch: nothing is written,
+// and an existing cache is discarded rather than loaded.
+func TestNetworkMapCacheOff(t *testing.T) {
+	t.Setenv("TS_USE_CACHED_NETMAP", "1")
+	ForceCacheNetworkMaps = true
+	t.Cleanup(func() { ForceCacheNetworkMaps = false; NetworkMapCacheOff.Store(false) })
+
+	clb, testMap, cacheDir := newOpenRouteCacheTest(t)
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	if countFiles(t, cacheDir) == 0 {
+		t.Fatal("netmap not cached")
+	}
+
+	NetworkMapCacheOff.Store(true)
+	if loadCached(clb) {
+		t.Fatal("cache loaded while turned off")
+	}
+	if n := countFiles(t, cacheDir); n != 0 {
+		t.Fatalf("cache has %d entries while turned off, want 0", n)
+	}
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	if n := countFiles(t, cacheDir); n != 0 {
+		t.Fatalf("cache written while turned off: %d entries", n)
+	}
+}
