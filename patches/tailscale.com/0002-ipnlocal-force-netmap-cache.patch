+// ForceCacheNetworkMaps, if set, caches network maps on disk even when the
+// control plane doesn't grant [nodecap.CacheNetworkMaps] (Headscale doesn't),
+// so the node can start from its last-known tailnet while offline.
+// [nodecap.DisableCacheNetworkMaps] still turns caching off.
+var ForceCacheNetworkMaps bool
+
+// cacheNetworkMapsEnabled reports whether network maps for cn should be
+// cached on disk.
+func cacheNetworkMapsEnabled(cn *nodeBackend) bool {
+	if cn.SelfHasCap(nodecap.DisableCacheNetworkMaps) {
+		return false
+	}
+	return ForceCacheNetworkMaps || cn.SelfHasCap(nodecap.CacheNetworkMaps)
+}
