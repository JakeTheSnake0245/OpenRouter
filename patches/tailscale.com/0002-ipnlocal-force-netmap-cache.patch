+// TestForceCacheNetworkMaps checks OpenRoute's override: with
+// ForceCacheNetworkMaps set, the netmap is cached without the control plane
+// granting the capability, and DisableCacheNetworkMaps still wins.
+func TestForceCacheNetworkMaps(t *testing.T) {
+	t.Setenv("TS_USE_CACHED_NETMAP", "1")
+	ForceCacheNetworkMaps = true
+	t.Cleanup(func() { ForceCacheNetworkMaps = false })
+
+	clb, testMap, cacheDir := newOpenRouteCacheTest(t)
+	cacheEntries := func() int {
+		des, err := os.ReadDir(cacheDir)
+		if err != nil && !os.IsNotExist(err) {
+			t.Fatalf("List cache directory: %v", err)
+		}
+		return len(des)
+	}
+
+	// No capability from control: cached anyway.
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	if cacheEntries() == 0 {
+		t.Fatal("netmap not cached with ForceCacheNetworkMaps set")
+	}
+
+	// Control explicitly disables caching: the cache is discarded.
+	testMap.AllCaps = set.Of(nodecap.DisableCacheNetworkMaps)
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	if n := cacheEntries(); n != 0 {
+		t.Fatalf("cache has %d entries after DisableCacheNetworkMaps, want 0", n)
+	}
+}
