+// xorStore is a toy NetmapCacheStoreHook wrapper that obscures values.
+type xorStore struct{ inner netmapcache.Store }
+
+func xor(b []byte) []byte {
+	out := make([]byte, len(b))
+	for i, c := range b {
+		out[i] = c ^ 0x5a
+	}
+	return out
+}
+
+func (s xorStore) List(ctx context.Context, prefix string) iter.Seq2[string, error] {
+	return s.inner.List(ctx, prefix)
+}
+
+func (s xorStore) Remove(ctx context.Context, key string) error { return s.inner.Remove(ctx, key) }
+
+func (s xorStore) Load(ctx context.Context, key string) ([]byte, error) {
+	b, err := s.inner.Load(ctx, key)
+	return xor(b), err
+}
+
+func (s xorStore) Store(ctx context.Context, key string, value []byte) error {
+	return s.inner.Store(ctx, key, xor(value))
+}
+
+// TestNetmapCacheStoreHook checks that the cache reads and writes through
+// NetmapCacheStoreHook.
+func TestNetmapCacheStoreHook(t *testing.T) {
+	t.Setenv("TS_USE_CACHED_NETMAP", "1")
+	ForceCacheNetworkMaps = true
+	NetmapCacheStoreHook = func(s netmapcache.Store) netmapcache.Store { return xorStore{s} }
+	t.Cleanup(func() { ForceCacheNetworkMaps = false; NetmapCacheStoreHook = nil })
+
+	clb, testMap, cacheDir := newOpenRouteCacheTest(t)
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+
+	des, err := os.ReadDir(cacheDir)
+	if err != nil || len(des) == 0 {
+		t.Fatalf("no cache files: %v", err)
+	}
+	for _, de := range des {
+		b, err := os.ReadFile(filepath.Join(cacheDir, de.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if bytes.Contains(b, []byte("phone.example.ts.net")) {
+			t.Fatalf("cache file %s holds plaintext", de.Name())
+		}
+	}
+
+	clb.mu.Lock()
+	clb.diskCache = diskCache{}
+	nm, ok := clb.loadDiskCacheLocked()
+	clb.mu.Unlock()
+	if !ok || nm.SelfNode.Name() != "phone.example.ts.net" {
+		t.Fatalf("load through hook: ok=%v", ok)
+	}
+}
