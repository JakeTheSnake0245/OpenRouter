+func countFiles(t *testing.T, dir string) int {
+	t.Helper()
+	des, err := os.ReadDir(dir)
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatalf("List cache directory: %v", err)
+	}
+	return len(des)
+}
+
+// loadCached reports whether clb would start from its cached netmap.
+func loadCached(clb *LocalBackend) bool {
+	clb.mu.Lock()
+	defer clb.mu.Unlock()
+	_, ok := clb.loadDiskCacheLocked()
+	return ok
+}
+
+// TestCachedNetworkMapMaxAge checks that a cache the control plane hasn't
+// confirmed within CachedNetworkMapMaxAge is discarded instead of loaded.
+func TestCachedNetworkMapMaxAge(t *testing.T) {
+	t.Setenv("TS_USE_CACHED_NETMAP", "1")
+	ForceCacheNetworkMaps = true
+	CachedNetworkMapMaxAge = time.Hour
+	t.Cleanup(func() { ForceCacheNetworkMaps = false; CachedNetworkMapMaxAge = 0 })
+
+	clb, testMap, cacheDir := newOpenRouteCacheTest(t)
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	if !loadCached(clb) {
+		t.Fatal("fresh cache not loaded")
+	}
+
+	stamp := netmapConfirmedPath(cacheDir)
+	old := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(stamp, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if loadCached(clb) {
+		t.Fatal("expired cache loaded")
+	}
+	if n := countFiles(t, cacheDir); n != 0 {
+		t.Fatalf("expired cache has %d entries, want 0", n)
+	}
+
+	// A cache with no confirmation record (e.g. written by an older build) is
+	// treated as expired.
+	clb.mu.Lock()
+	clb.diskCache.confirmedAt = time.Time{}
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	os.Remove(stamp)
+	if loadCached(clb) {
+		t.Fatal("unconfirmed cache loaded")
+	}
+}
