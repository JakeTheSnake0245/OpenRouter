+// TestForceCacheNetworkMaps checks OpenRoute's override: with
+// ForceCacheNetworkMaps set, the netmap is cached without the control plane
+// granting the capability, and DisableCacheNetworkMaps still wins.
+func TestForceCacheNetworkMaps(t *testing.T) {
+	t.Setenv("TS_USE_CACHED_NETMAP", "1")
+	ForceCacheNetworkMaps = true
+	t.Cleanup(func() { ForceCacheNetworkMaps = false })
+
+	varRoot := t.TempDir()
+	cacheDir := filepath.Join(varRoot, "profile-data", "id0", "netmap-cache")
+
+	testMap := &netmap.NetworkMap{
+		SelfNode: (&tailcfg.Node{
+			Name:      "phone.example.ts.net",
+			User:      tailcfg.UserID(1),
+			Addresses: []netip.Prefix{netip.MustParsePrefix("100.2.3.4/32")},
+		}).View(),
+		UserProfiles: map[tailcfg.UserID]tailcfg.UserProfileView{
+			tailcfg.UserID(1): (&tailcfg.UserProfile{ID: 1, LoginName: "user@example.com"}).View(),
+		},
+		Peers: []tailcfg.NodeView{
+			(&tailcfg.Node{
+				ID:        601,
+				StableID:  "n601FAKE",
+				User:      tailcfg.UserID(1),
+				Key:       makeNodeKeyFromID(601),
+				Addresses: []netip.Prefix{netip.MustParsePrefix("100.2.3.5/32")},
+			}).View(),
+		},
+	}
+
+	sys := tsd.NewSystem()
+	e, err := wgengine.NewFakeUserspaceEngine(logger.Discard,
+		sys.Set,
+		sys.HealthTracker.Get(),
+		sys.UserMetricsRegistry(),
+		sys.Bus.Get(),
+	)
+	if err != nil {
+		t.Fatalf("Make userspace engine: %v", err)
+	}
+	t.Cleanup(e.Close)
+	sys.Set(e)
+	sys.Set(new(mem.Store))
+
+	logf := tstest.WhileTestRunningLogger(t)
+	clb, err := NewLocalBackend(logf, logid.PublicID{}, sys, 0)
+	if err != nil {
+		t.Fatalf("Make local backend: %v", err)
+	}
+	t.Cleanup(clb.Shutdown)
+	clb.SetVarRoot(varRoot)
+
+	pm := must.Get(newProfileManager(new(mem.Store), logf, health.NewTracker(sys.Bus.Get())))
+	pm.currentProfile = (&ipn.LoginProfile{ID: "id0"}).View()
+	clb.pm = pm
+	if err := clb.Start(ipn.Options{}); err != nil {
+		t.Fatalf("Start local backend: %v", err)
+	}
+
+	cacheEntries := func() int {
+		des, err := os.ReadDir(cacheDir)
+		if err != nil && !os.IsNotExist(err) {
+			t.Fatalf("List cache directory: %v", err)
+		}
+		return len(des)
+	}
+
+	// No capability from control: cached anyway.
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	if cacheEntries() == 0 {
+		t.Fatal("netmap not cached with ForceCacheNetworkMaps set")
+	}
+
+	// Control explicitly disables caching: the cache is discarded.
+	testMap.AllCaps = set.Of(nodecap.DisableCacheNetworkMaps)
+	clb.mu.Lock()
+	clb.setNetMapLocked(testMap)
+	clb.mu.Unlock()
+	if n := cacheEntries(); n != 0 {
+		t.Fatalf("cache has %d entries after DisableCacheNetworkMaps, want 0", n)
+	}
+}
